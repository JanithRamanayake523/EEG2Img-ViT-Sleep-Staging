# ---------------------------------------------------------------- local-only material
# Everything private (full papers, abstracts, thesis, speaker notes, archives) lives in _local/,
# which mirrors the repository layout. Nothing in it is published.
/_local/
_archive*/

# ---------------------------------------------------------------- data and outputs
# Keep data/README.md, ignore everything else in data/
/data/*
!/data/README.md
/results/
/checkpoints/
runs/
wandb/
lightning_logs/
*.edf
*.edf+
*.rec
*.npy
*.npz
*.h5
*.pt
*.pth
*.ckpt
*.safetensors

# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------------------------------------------------------------- OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*
